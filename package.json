{
  "name": "@veridex/goat-agentkit",
  "version": "0.1.0",
  "description": "Verifiable Economic Policy Enforcement & ERC-8004 Validation Artifacts for GOAT AgentKit",
  "license": "MIT",
  "author": "Veridex Team <team@veridex.network>",
  "homepage": "https://github.com/Veridex-Protocol/goat-agentkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veridex-Protocol/goat-agentkit.git"
  },
  "bugs": {
    "url": "https://github.com/Veridex-Protocol/goat-agentkit/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "registry:verify-artifact": "npm run build --silent && node scripts/verifyRegistryArtifact.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1115.0",
    "ethers": "6.17.0",
    "pg": "8.23.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.21.0",
    "solc": "0.8.20",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "tmp": "0.2.7"
  },
  "keywords": [
    "goat-network",
    "agentkit",
    "erc8004",
    "veridex",
    "x402",
    "policy",
    "evidence-bundle"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
